{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramps-web/status/status_payload.schema.json",
  "title": "GET /_status/data response",
  "description": "Single source of truth for the shape status.py's collect_status() (plus data_response()'s four caller-specific fields) sends the frontend. Kept in the same directory as its producer (status.py) rather than under build/web, so the schema moves in the same commit as the collector; it is excluded from the Lambda zip because archive_file lists its sources explicitly (see main.tf). TS types are generated from this file at build time (npm run codegen); a Python test validates real collect_status() output against it; a pre-commit hook validates every frontend test fixture against it. Every panel value is `oneOf` [its real shape, PanelError] because safe_section() degrades any panel to {\"error\": ...} on an AWS failure, and collect_status() injects {\"error\": \"timed out\"} on a deadline miss -- that union is the whole point of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["min_role", "caller_role", "gramps_web_version", "source_repo", "spot_enabled", "reliability", "incidents", "changes", "interruptions", "host", "image", "storage", "deployment"],
  "properties": {
    "min_role": { "type": "string", "description": "MIN_ROLE env var, e.g. \"member\"." },
    "caller_role": { "type": "string", "description": "The authenticated caller's own role name." },
    "gramps_web_version": { "type": "string" },
    "source_repo": { "type": "string", "description": "SOURCE_REPO env var, e.g. \"example/gramps-web\" -- the GitHub repo both the Rollout and Machine-image Commit cells link into." },

    "spot_enabled": { "type": "boolean", "description": "SPOT_ENABLED env var: whether the fleet runs on Spot. Lets the Spot reclaims panel show before the first reclaim." },

    "reliability": { "oneOf": [{ "$ref": "#/$defs/Reliability" }, { "$ref": "#/$defs/PanelError" }] },
    "incidents": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/Episode" } },
        { "$ref": "#/$defs/PanelError" }
      ]
    },
    "changes": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/Change" } },
        { "$ref": "#/$defs/PanelError" }
      ]
    },
    "interruptions": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/Interruption" } },
        { "$ref": "#/$defs/PanelError" }
      ]
    },
    "host": { "oneOf": [{ "$ref": "#/$defs/Host" }, { "$ref": "#/$defs/PanelError" }] },
    "image": { "oneOf": [{ "$ref": "#/$defs/Image" }, { "$ref": "#/$defs/PanelError" }] },
    "storage": { "oneOf": [{ "$ref": "#/$defs/Storage" }, { "$ref": "#/$defs/PanelError" }] },
    "deployment": { "oneOf": [{ "$ref": "#/$defs/Deployment" }, { "$ref": "#/$defs/PanelError" }] },

    "backups": { "oneOf": [{ "$ref": "#/$defs/Backups" }, { "$ref": "#/$defs/PanelError" }] },
    "assistant": { "oneOf": [{ "$ref": "#/$defs/Assistant" }, { "$ref": "#/$defs/PanelError" }] },
    "cost": { "oneOf": [{ "$ref": "#/$defs/Cost" }, { "$ref": "#/$defs/PanelError" }] },
    "host_metrics": { "oneOf": [{ "$ref": "#/$defs/HostMetrics" }, { "$ref": "#/$defs/PanelError" }] }
  },

  "$defs": {
    "PanelError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": { "error": { "type": "string" } }
    },

    "RangeKey": { "enum": ["24h", "7d", "30d", "90d", "1y"] },

    "Reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranges", "slo_good_threshold", "slo_warn_threshold", "decimals"],
      "properties": {
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "$ref": "#/$defs/RangeKey" },
          "minProperties": 1,
          "properties": {
            "24h": { "$ref": "#/$defs/ReliabilityRange" },
            "7d": { "$ref": "#/$defs/ReliabilityRange" },
            "30d": { "$ref": "#/$defs/ReliabilityRange" },
            "90d": { "$ref": "#/$defs/ReliabilityRange" },
            "1y": { "$ref": "#/$defs/ReliabilityRange" }
          }
        },
        "slo_good_threshold": { "type": "number" },
        "slo_warn_threshold": { "type": "number" },
        "decimals": { "type": "integer", "minimum": 0 }
      }
    },
    "ReliabilityRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uptime", "uptime_excl_planned", "cells", "latency", "cell_s", "checks"],
      "properties": {
        "uptime": { "type": ["number", "null"] },
        "uptime_excl_planned": { "type": ["number", "null"] },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/ReliabilityCell" } },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe"],
          "properties": {
            "probe": { "type": "array", "items": { "$ref": "#/$defs/LatencyBucket" } }
          }
        },
        "cell_s": { "type": "integer", "minimum": 1 },
        "checks": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "ReliabilityCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "avg", "samples", "partial", "expected_samples"],
      "properties": {
        "label": { "type": "string" },
        "avg": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "samples": { "type": "integer", "minimum": 0 },
        "partial": { "type": "boolean" },
        "expected_samples": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "LatencyBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p90"],
      "properties": {
        "p50": { "type": ["number", "null"] },
        "p90": { "type": ["number", "null"] }
      }
    },

    "InstanceRef": {
      "description": "availability.py's describe_instance() shape; old_instance additionally carries `time` for a spot-reclaim marker, new_instance never does.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "az", "arch", "launched"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "az": { "type": "string" },
        "arch": { "type": "string" },
        "launched": { "type": "string" },
        "lifecycle": { "enum": ["spot", "on-demand"] },
        "time": { "type": "string" }
      }
    },
    "Change": {
      "description": "One deliberate change recorded by availability.py's change log, newest first; `outage` is derived by status.py from overlap with the episodes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "kind", "id", "creator", "outcome", "duration_s", "description", "outage"],
      "properties": {
        "at": { "type": "string", "description": "Completion time." },
        "kind": { "enum": ["deploy", "instance-refresh"] },
        "id": { "type": "string" },
        "creator": { "type": ["string", "null"], "description": "CodeDeploy creator (user, autoscaling, codeDeployRollback, ...); null for an instance refresh." },
        "outcome": { "enum": ["succeeded", "failed", "stopped", "cancelled", "rollback-succeeded", "rollback-failed"] },
        "duration_s": { "type": ["integer", "null"], "minimum": 0 },
        "description": { "type": ["string", "null"] },
        "outage": { "type": "boolean" }
      }
    },
    "Interruption": {
      "description": "One Spot interruption warning from the EventBridge log.",
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "instance_id", "action"],
      "properties": {
        "time": { "type": "string" },
        "instance_id": { "type": "string" },
        "action": { "type": ["string", "null"] }
      }
    },
    "Episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started", "duration_s", "cause", "planned"],
      "properties": {
        "started": { "type": "string" },
        "ended": { "type": "string" },
        "duration_s": { "type": "integer", "minimum": 0 },
        "cause": {
          "enum": ["spot-reclaim", "rightsize", "health-watchdog", "health-replace", "deploy", "instance-refresh", "capacity-change", "backup", "unknown"]
        },
        "planned": { "type": "boolean" },
        "capacity_wait_s": { "type": ["integer", "null"], "minimum": 0 },
        "boot_to_serve_s": { "type": ["integer", "null"], "minimum": 0 },
        "lifecycle": { "enum": ["spot", "on-demand", null] },
        "spot_price": { "type": ["number", "null"], "minimum": 0 },
        "old_instance": { "oneOf": [{ "$ref": "#/$defs/InstanceRef" }, { "type": "null" }] },
        "new_instance": { "oneOf": [{ "$ref": "#/$defs/InstanceRef" }, { "type": "null" }] }
      }
    },

    "Host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "instance"],
      "properties": {
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desired", "min", "max"],
          "properties": {
            "desired": { "type": "integer" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        "instance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "architecture", "az", "lifecycle", "launch_time", "uptime_s", "ami_id", "root_volume_id"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "architecture": { "type": "string" },
                "az": { "type": "string" },
                "lifecycle": { "type": "string" },
                "launch_time": { "type": "string" },
                "uptime_s": { "type": "integer", "minimum": 0 },
                "ami_id": { "type": "string" },
                "root_volume_id": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },

    "Image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "creation_date", "git_sha", "source_ami", "source_ami_name", "source_ami_description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "creation_date": { "type": ["string", "null"] },
        "git_sha": { "type": ["string", "null"] },
        "source_ami": { "type": ["string", "null"] },
        "source_ami_name": { "type": ["string", "null"] },
        "source_ami_description": { "type": ["string", "null"] }
      }
    },

    "Volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id", "device", "size_gb", "type", "iops", "encrypted", "state"],
      "properties": {
        "role": { "enum": ["data", "root"] },
        "id": { "type": "string" },
        "device": { "type": ["string", "null"] },
        "size_gb": { "type": ["integer", "null"] },
        "type": { "type": ["string", "null"] },
        "iops": { "type": ["integer", "null"] },
        "encrypted": { "type": ["boolean", "null"] },
        "state": { "type": ["string", "null"] }
      }
    },
    "Storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket_size_bytes", "bucket_object_count"],
      "properties": {
        "volumes": { "type": "array", "items": { "$ref": "#/$defs/Volume" } },
        "volume_error": { "type": "string" },
        "bucket_size_bytes": { "type": ["number", "null"] },
        "bucket_object_count": { "type": ["integer", "null"] }
      }
    },

    "DeploymentSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "status", "create_time", "commit"],
          "properties": {
            "id": { "type": ["string", "null"] },
            "status": { "type": ["string", "null"] },
            "create_time": { "type": ["string", "null"] },
            "commit": { "type": ["string", "null"], "description": "SHA, resolved against source_repo." }
          }
        },
        { "type": "null" }
      ]
    },
    "Deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest", "latest_succeeded"],
      "properties": {
        "latest": { "$ref": "#/$defs/DeploymentSummary" },
        "latest_succeeded": { "$ref": "#/$defs/DeploymentSummary" },
        "ecr_latest_image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags", "digest", "pushed_at"],
          "properties": {
            "tags": { "type": "array", "items": { "type": "string" } },
            "digest": { "type": ["string", "null"] },
            "pushed_at": { "type": ["string", "null"] }
          }
        },
        "ecr_error": { "type": "string" }
      }
    },

    "CompletionSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "age_s"],
          "properties": {
            "completed": { "type": "string" },
            "age_s": { "type": "integer" }
          }
        },
        { "type": "null" }
      ]
    },
    "Backups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "schedule", "retention_days", "resource_count", "remote_retention_days"],
      "properties": {
        "mode": { "type": "string" },
        "schedule": { "type": "string" },
        "retention_days": { "type": ["integer", "null"] },
        "resource_count": { "type": ["integer", "null"] },
        "remote_retention_days": { "type": ["integer", "null"] },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "region", "recovery_points", "locked"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "region": { "type": "string" },
            "recovery_points": { "type": ["integer", "null"] },
            "locked": { "type": "boolean" }
          }
        },
        "vault_error": { "type": "string" },
        "latest_backup": { "$ref": "#/$defs/CompletionSummary" },
        "backup_jobs_error": { "type": "string" },
        "latest_copy": { "$ref": "#/$defs/CompletionSummary" },
        "copy_jobs_error": { "type": "string" },
        "failed_jobs_7d": { "type": "integer", "minimum": 0 },
        "failed_jobs_error": { "type": "string" },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "region", "account_id"],
          "properties": {
            "name": { "type": "string" },
            "region": { "type": "string" },
            "account_id": { "type": "string" },
            "locked": { "type": "boolean" },
            "recovery_points": { "type": ["integer", "null"] }
          }
        },
        "destination_error": { "type": "string" }
      }
    },

    "Assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "region", "max_requests", "max_tokens", "max_context_length", "token_ranges"],
      "properties": {
        "model_id": { "type": "string" },
        "region": { "type": "string" },
        "max_requests": { "type": ["integer", "null"] },
        "max_tokens": { "type": ["integer", "null"] },
        "max_context_length": { "type": ["integer", "null"] },
        "token_ranges": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "$ref": "#/$defs/RangeKey" },
          "properties": {
            "24h": { "$ref": "#/$defs/TokenSeries" },
            "7d": { "$ref": "#/$defs/TokenSeries" },
            "30d": { "$ref": "#/$defs/TokenSeries" },
            "90d": { "$ref": "#/$defs/TokenSeries" },
            "1y": { "$ref": "#/$defs/TokenSeries" }
          }
        }
      }
    },
    "TokenSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "output": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    },

    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month_to_date_usd", "top_services", "budget_usd"],
      "properties": {
        "month_to_date_usd": { "type": "number" },
        "top_services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "amount_usd"],
            "properties": {
              "service": { "type": "string" },
              "amount_usd": { "type": "number" }
            }
          }
        },
        "budget_usd": { "type": ["number", "null"] }
      }
    },

    "HostMetricSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "ranges"],
      "properties": {
        "current": { "type": ["number", "null"] },
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "$ref": "#/$defs/RangeKey" },
          "properties": {
            "24h": { "type": "array", "items": { "type": ["number", "null"] } },
            "7d": { "type": "array", "items": { "type": ["number", "null"] } },
            "30d": { "type": "array", "items": { "type": ["number", "null"] } },
            "90d": { "type": "array", "items": { "type": ["number", "null"] } },
            "1y": { "type": "array", "items": { "type": ["number", "null"] } }
          }
        }
      }
    },
    "HostMetrics": {
      "description": "Per HOST_METRIC_SPECS key, either a HostMetricSeries or a `<key>_error` string -- host_metrics()'s own per-metric error isolation. disk_used_percent is mutually exclusive with the four disk_*_bytes_* keys: VOLUME_METRICS_ENABLED picks which arm HOST_METRIC_SPECS carries, and the publisher (build/ami/health-watchdog.sh) only ever emits the matching series.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_percent": { "$ref": "#/$defs/HostMetricSeries" },
        "cpu_percent_error": { "type": "string" },
        "mem_used_percent": { "$ref": "#/$defs/HostMetricSeries" },
        "mem_used_percent_error": { "type": "string" },
        "disk_used_percent": { "$ref": "#/$defs/HostMetricSeries" },
        "disk_used_percent_error": { "type": "string" },
        "disk_used_bytes_data": { "$ref": "#/$defs/HostMetricSeries" },
        "disk_used_bytes_data_error": { "type": "string" },
        "disk_total_bytes_data": { "$ref": "#/$defs/HostMetricSeries" },
        "disk_total_bytes_data_error": { "type": "string" },
        "disk_used_bytes_root": { "$ref": "#/$defs/HostMetricSeries" },
        "disk_used_bytes_root_error": { "type": "string" },
        "disk_total_bytes_root": { "$ref": "#/$defs/HostMetricSeries" },
        "disk_total_bytes_root_error": { "type": "string" }
      }
    }
  }
}
