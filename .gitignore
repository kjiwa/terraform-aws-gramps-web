# Created by init in the root module, the child modules, and the examples. Only
# the examples' lock files are tracked; a module's consumer owns its own.
.terraform/
.terraform.lock.hcl
!examples/*/.terraform.lock.hcl
*.tfstate
*.tfstate.backup
# State backups written by scripts/azmove.sh adopt.
azmove-state-*.json
# Restore drill manifests written by scripts/restore.sh drill -- carry the same
# account-scoped detail as state.
restore-drill-*.json
# Python bytecode cache, left behind by running the plugin tests.
__pycache__/
*.pyc

# Build scratch, assembled inside each component by its build.sh. The app's two
# stage dirs are the docker build context's only contents (.dockerignore
# whitelists exactly them), so they cannot leak into an image -- these entries
# are only about keeping a local build out of git status.
build/app/addons-stage/
build/app/frontend-stage/
build/app/.addons-source/
build/app/.gramps-web-source/

# build/web is an npm project (CloudFront error pages). Build outputs are
# regenerated by `npm run build` and published to S3 by the gramps-web-frontend
# CodeBuild project, never committed.
build/web/node_modules/
build/web/dist/
build/web/pages/errors/generated/
build/web/test-results/
build/web/playwright-report/
build/web/.vite/
