# Created by init in the root module, the child modules, and the examples. Only
# the examples' lock files are tracked; a module's consumer owns its own.
.terraform/
.terraform.lock.hcl
!examples/*/.terraform.lock.hcl
*.tfstate
*.tfstate.backup
# State backups written by scripts/azmove.sh adopt.
scripts/azmove-state-*.json
# Restore drill manifests written by scripts/restore.sh drill -- carry the same
# account-scoped detail as state.
scripts/restore-drill-*.json
# archive_file artifact rebuilt by every plan/apply; never commit it.
modules/monitoring/lambda/availability.zip
# Same, for the status Lambda -- built from lambda/ (2 files) into dist/ so
# the archive_file output_path can't recursively zip itself.
modules/status/dist/
# Python bytecode cache, left behind by running a Lambda's .py source locally
# (e.g. python3 -m py_compile). archive_file zips the source directly, so
# this is never part of a deployed package.
__pycache__/
*.pyc

# Build scratch, assembled inside each component by its build.sh. The app's two
# stage dirs are the docker build context's only contents (.dockerignore
# whitelists exactly them), so they cannot leak into an image -- these entries
# are only about keeping a local build out of git status.
build/app/addons-stage/
build/app/frontend-stage/
build/app/.addons-source/
build/app/.gramps-web-source/

# build/web is a real npm project (frontend for the status page and error
# pages). node_modules and every build output are
# gitignored like any other npm project's; dist/, src/generated/, and
# pages/errors/generated/ are all regenerated by `npm run build` and
# published straight to S3 by the gramps-web-frontend CodeBuild project --
# never committed, unlike build/status/dist/'s zip above.
build/web/node_modules/
build/web/dist/
build/web/src/generated/
build/web/pages/errors/generated/
build/web/test-results/
build/web/playwright-report/
build/web/.vite/
