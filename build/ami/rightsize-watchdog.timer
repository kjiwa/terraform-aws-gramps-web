# Fires the rightsize check. Daily 09:00 UTC is only the baked-in fallback:
# user-data overrides OnCalendar via a drop-in from rightsize.schedule on the
# module (daily to hourly), so set the schedule there, not
# here. The check is a no-op when no eligible Spot pool is meaningfully cheaper
# than the current one (or the instance is not Spot), and the script's own
# uptime cooldown bounds replacement churn under aggressive schedules, so the
# timer frequency is a responsiveness knob, not a safety one. No Persistent=: the instance is
# always on, and a missed tick self-corrects at the next one.
[Unit]
Description=Run gramps rightsize check

[Timer]
OnCalendar=*-*-* 09:00:00 UTC

[Install]
WantedBy=timers.target
