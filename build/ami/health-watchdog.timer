# Fires the health check every minute, starting 90s after boot (user-data and
# the first CodeDeploy run own that window; the script also self-gates on
# instance.env existing).
[Unit]
Description=Run gramps app health check every minute

[Timer]
OnBootSec=90
OnUnitActiveSec=60
AccuracySec=15

[Install]
WantedBy=timers.target
